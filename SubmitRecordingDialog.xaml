<Window x:Class="FischMacroCS.SubmitRecordingDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Private diagnostic report" Width="1000" Height="800" MinWidth="850" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="#101722" Foreground="#E2E8F0">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="#182435"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="BorderBrush" Value="#405168"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#182435"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="BorderBrush" Value="#405168"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#182435"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="BorderBrush" Value="#405168"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#D4E8F0"/><Setter Property="Foreground" Value="#101722"/></Style>
 </Window.Resources>
 <Grid Margin="18">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock FontSize="20" Text="Review and send a private report" Margin="0,0,0,12"/>
 <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Margin="0,0,12,0">
   <TextBlock DockPanel.Dock="Top" Text="Completed sessions"/>
   <ListBox x:Name="LstSessions" DisplayMemberPath="DisplayName" SelectionChanged="SessionChanged"/>
  </DockPanel>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="TxtSummaryPreview" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="Frames to include"/>
     <Button DockPanel.Dock="Top" Content="Select first incident" Click="SelectIncidentClick" ToolTip="Select saved context images before and after the first position or recovery incident."/>
     <ListBox x:Name="LstFrames" SelectionMode="Extended" SelectionChanged="FrameChanged"/>
    </DockPanel>
    <Image x:Name="ImgFrame" Grid.Column="1" Stretch="Uniform" Margin="8"/>
   </Grid>
   <StackPanel Grid.Row="2">
    <TextBlock Text="Optional black mask on selected images: x,y,width,height (pixels). Review each selected image." TextWrapping="Wrap"/>
    <TextBox x:Name="TxtMask" Text="0,0,0,0" TextChanged="MaskChanged"/>
    <TextBlock Text="No frames selected means text-only. Images may contain names and chat; masking is manual." TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
 </Grid>
 <Grid Grid.Row="2" Margin="0,12,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,12,0">
   <TextBlock Text="Private GitHub destination (owner/repository)"/>
   <TextBox x:Name="TxtRepository"/>
   <TextBlock Text="Repository token (leave blank to use saved credential)"/>
   <PasswordBox x:Name="TxtToken" Padding="6" Margin="0,4,0,8"/>
   <TextBlock Text="Setup: private repository, diagnostics release, token with Issues and Contents write permissions." FontSize="11" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel Grid.Column="1">
   <TextBlock Text="Description (optional)"/>
   <TextBox x:Name="TxtDescription" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
   <TextBlock x:Name="TxtStatus" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
 <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
  <Button Content="Replay / label" Click="ReplayClick"/>
  <Button Content="Export ZIP" Click="ExportClick"/>
  <Button x:Name="BtnSend" Content="Send report" Click="SendClick"/>
  <Button Content="Close" Click="CloseClick"/>
 </StackPanel>
 </Grid>
</Window>
