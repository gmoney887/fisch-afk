<Window x:Class="FischMacroCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fat Dad's Fisch AFK Pro v1.0" Height="720" Width="470" MinHeight="500" MinWidth="380"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Icon="app_icon.ico"
        Background="#0D0F14" Foreground="#E0E0E0"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#171A23"/>
            <Setter Property="BorderBrush" Value="#252A38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Metric Label Style -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Metric Value Style -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Modern Dark ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="templateRoot" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" 
                    SnapsToDevicePixels="true">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <!-- Dropdown Arrow -->
                    <Path x:Name="arrow" 
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0" 
                          Stroke="#94A3B8" 
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#161B26"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#00E5FF"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#00E5FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Dark ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}" 
                                CornerRadius="4" 
                                Margin="2,1"
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#0F3854"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true"/>
                                    <Condition Property="IsMouseOver" Value="true"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox Global Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#0F1117"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D3344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="true" 
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Margin="1" 
                                   PopupAnimation="Fade" 
                                   Placement="Bottom">
                                <Border x:Name="dropDownBorder" 
                                        Background="#0E121B" 
                                        BorderBrush="#2D3344" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinHeight="30"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        Padding="3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.85" ShadowDepth="6"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" Focusable="False">
                                        <ItemsPresenter x:Name="ItemsPresenter" 
                                                        KeyboardNavigation.DirectionalNavigation="Contained" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                            <ToggleButton x:Name="toggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}"/>

                            <ContentPresenter x:Name="contentPresenter" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              IsHitTestVisible="false" 
                                              Margin="{TemplateBinding Padding}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox Global Style -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0F1117"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D3344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Session Analytics HUD -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Status & Main Control -->
                    <RowDefinition Height="Auto"/> <!-- Row 3: Vision Camera Preview -->
                    <RowDefinition Height="Auto"/> <!-- Row 4: Settings & Footer -->
                </Grid.RowDefinitions>

                <!-- 1. HEADER -->
                <Border Grid.Row="0" Background="#12151F" BorderBrush="#1F2535" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Title & Hotkey Row -->
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <Border Width="38" Height="38" CornerRadius="19" BorderBrush="#00E5FF" BorderThickness="1.5" Margin="0,0,9,0" Background="#161B26" Cursor="Hand" ToolTip="Click to view mascot artwork" MouseLeftButtonDown="Avatar_MouseLeftButtonDown">
                                    <Image Source="app_icon.png" Stretch="Uniform" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="FAT DAD'S" FontSize="14.5" FontWeight="Black" Foreground="#00E5FF" Margin="0,0,5,0"/>
                                        <TextBlock Text="FISCH AFK" FontSize="14.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                        <Border Background="#1E293B" CornerRadius="3" Margin="6,0,0,0" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="v1.0 PRO" FontSize="9" FontWeight="Black" Foreground="#38BDF8"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Roblox Fisch Kinetic Angler" FontSize="9.5" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Hotkey Start/Stop Badge -->
                            <Border DockPanel.Dock="Right" Background="#1E2433" BorderBrush="#2A3347" BorderThickness="1" CornerRadius="6" Padding="7,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeaderHotkey" Text="[F6] START/STOP" FontSize="9.5" FontWeight="Black" Foreground="#00E5FF"/>
                            </Border>
                        </DockPanel>

                        <!-- CATEGORIZED ACTION TOOLBARS -->
                        <Grid Margin="0,7,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CATEGORY 1: DISPLAY & WINDOW OPTIONS (Display Only) -->
                            <Border Grid.Row="0" Background="#0C0F17" BorderBrush="#1C2333" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,5">
                                <DockPanel LastChildFill="True">
                                    <Border Background="#161F30" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <TextBlock Text="DISPLAY" FontSize="8.5" FontWeight="Black" Foreground="#38BDF8" VerticalAlignment="Center" ToolTip="Display &amp; window layout options only (Safe anytime)"/>
                                    </Border>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="BtnSnapSideBySide" Click="BtnSnapSideBySide_Click" Content="📐 Side-by-Side"
                                                Background="#0F3854" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                                                FontSize="9.5" FontWeight="Bold" Padding="6,2.5" Margin="0,0,4,2" Cursor="Hand"
                                                ToolTip="Display Option: Arrange Roblox on left and Angler on right with zero overlap">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button x:Name="BtnWindowed" Click="BtnWindowed_Click" Content="🖥 Windowed"
                                                Background="#1A263D" Foreground="#38BDF8" BorderBrush="#2563EB" BorderThickness="1"
                                                FontFamily="Segoe UI Emoji, Segoe UI" FontSize="9.5" FontWeight="Bold" Padding="6,2.5" Margin="0,0,4,2" Cursor="Hand"
                                                ToolTip="Display Option: Roblox expands windowed while Angler floats in top-right corner">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Border Background="#131824" BorderBrush="#252C3E" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,4,2" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkAlwaysOnTop" Content="📌 On Top" IsChecked="True" 
                                                      Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed"
                                                      Foreground="#CBD5E1" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"
                                                      ToolTip="Display Option: Keep macro window topmost over other windows"/>
                                        </Border>

                                        <Button x:Name="BtnOpenRecordings" Click="BtnOpenRecordings_Click" Content="📁 Clips" 
                                                Background="#171C28" Foreground="#94A3B8" BorderBrush="#2A3347" BorderThickness="1" FontSize="9.5" FontWeight="Bold" 
                                                Padding="6,2.5" Margin="0,0,0,2" Cursor="Hand" ToolTip="Display Option: Open recorded fish catch clips folder in Explorer">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- CATEGORY 2: STANDALONE TASKS (Requires NOT to be fishing) -->
                            <Border Grid.Row="1" Background="#0C0F17" BorderBrush="#26221A" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0">
                                        <Border Background="#2B1E0C" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="TASKS" FontSize="8.5" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="TxtTasksIdleBadge" Text="(Idle Only)" FontSize="8" Foreground="#64748B" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="BtnClaimAquarium" Click="BtnClaimAquarium_Click" Content="🏆 Aquarium" 
                                                Background="#0A241E" Foreground="#34D399" BorderBrush="#059669" BorderThickness="1" FontSize="9.5" FontWeight="Bold" 
                                                Padding="6,2.5" Margin="0,0,4,0" Cursor="Hand" ToolTip="Requires NOT Fishing: Opens Aquarium, claims hourly profit (C$ + XP), and returns">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button x:Name="BtnOpenCrates" Click="BtnOpenCrates_Click" Content="📦 Crates" 
                                                Background="#211508" Foreground="#FBBF24" BorderBrush="#D97706" BorderThickness="1" FontSize="9.5" FontWeight="Bold" 
                                                Padding="6,2.5" Margin="0,0,0,0" Cursor="Hand" ToolTip="Requires NOT Fishing: Unequips rod, opens Equipment ('g'), searches 'crate', unpacks all crates, and re-equips rod">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. SESSION ANALYTICS CARD -->
                <Border Grid.Row="1" Background="#121622" BorderBrush="#1F283D" BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Reset Button -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <TextBlock Text="📊 SESSION ANALYTICS" FontSize="9" FontWeight="Black" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtStreakBadge" Text="🔥 Streak: 0" FontSize="9" FontWeight="Bold" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="BtnResetStats" Click="BtnResetStats_Click" Content="↺ Reset" DockPanel.Dock="Right"
                                    Background="#1A202C" Foreground="#94A3B8" BorderBrush="#2D3748" BorderThickness="1"
                                    FontSize="9" FontWeight="SemiBold" Padding="6,1" Cursor="Hand" ToolTip="Applies While Fishing: Reset session catch and uptime counters without stopping">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>

                        <!-- 4 Stat Badges Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Stat 1: Total Catches -->
                            <Border Grid.Column="0" Background="#0C101A" BorderBrush="#1A2333" BorderThickness="1" CornerRadius="5" Padding="4,4" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CATCHES" FontSize="8" FontWeight="Black" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTotalCatches" Text="0" FontSize="15" FontWeight="Black" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat 2: Catches Per Hour -->
                            <Border Grid.Column="1" Background="#0C101A" BorderBrush="#1A2333" BorderThickness="1" CornerRadius="5" Padding="4,4" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="RATE (CPH)" FontSize="8" FontWeight="Black" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCatchRate" Text="0.0/hr" FontSize="15" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat 3: Win Rate -->
                            <Border Grid.Column="2" Background="#0C101A" BorderBrush="#1A2333" BorderThickness="1" CornerRadius="5" Padding="4,4" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="WIN RATE" FontSize="8" FontWeight="Black" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWinRate" Text="100%" FontSize="15" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat 4: Session Uptime -->
                            <Border Grid.Column="3" Background="#0C101A" BorderBrush="#1A2333" BorderThickness="1" CornerRadius="5" Padding="4,4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="UPTIME" FontSize="8" FontWeight="Black" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSessionUptime" Text="00:00:00" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. STATUS & CONTROLS CARD -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Primary Action: Start / Stop Fishing -->
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <!-- Big Start/Stop Fishing Button (Automatically equips rod upon start) -->
                            <Button x:Name="BtnToggle" Click="BtnToggle_Click" Cursor="Hand"
                                    ToolTip="Starts or stops automated fishing loop. Automatically ensures fishing rod is equipped and active in hand. [F6]">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="#10B981" CornerRadius="6" Padding="6,10">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="txtBtnState" Text="START FISHING" FontSize="13" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock x:Name="txtBtnSub" Text="Press F6" FontSize="10" FontWeight="SemiBold" Foreground="#D1FAE5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Live Telemetry (2 Columns with clean spacing) -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- State Badge -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                <TextBlock Text="STATUS" Style="{StaticResource MetricLabel}"/>
                                <Border x:Name="BadgeState" Background="#374151" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtState" Text="READY" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                </Border>
                            </StackPanel>

                            <!-- Action Text -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock Text="ACTION" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtAction" Text="Idle" Style="{StaticResource MetricValue}" FontSize="11" Foreground="#00E5FF" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Catch Bar -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,6">
                                <TextBlock Text="CATCH BAR" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtBarPos" Text="Waiting..." Style="{StaticResource MetricValue}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Fish Needle -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock Text="FISH NEEDLE" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtFishPos" Text="Waiting..." Style="{StaticResource MetricValue}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Latency & Rod Acceleration Bar -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#0D1017" CornerRadius="4" Padding="6,3" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtLatency" Text="Vision: -- | Loop: --" Style="{StaticResource MetricValue}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. LIVE OPENCV VISION CAMERA FEED (COMPACT MONITOR - ZERO WASTED SPACE) -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Monitor Header with Recording Controls -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <TextBlock Text="LIVE CV MONITOR" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRecordingIndicator" Text="● REC" FontSize="10" FontWeight="Black" Foreground="#EF4444" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                                <CheckBox x:Name="ChkEnableRecording" Content="Record" IsChecked="True" Foreground="#8A94A6" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cap:" FontSize="10" Foreground="#8A94A6" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBox x:Name="TxtMaxRecordings" Text="25" Width="26" Height="18" Background="#0F1117" Foreground="#FFFFFF" BorderBrush="#2D3344" Padding="0" FontSize="10" TextAlignment="Center" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkShowPreview" Content="Preview" IsChecked="True" Foreground="#8A94A6" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Vision Image Container: Clean 125px height with crisp scaling -->
                        <Border Grid.Row="1" Background="#0A0C10" CornerRadius="6" BorderBrush="#1C202C" BorderThickness="1" Height="125" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPreviewPlaceholder" Text="Camera preview starts when fishing begins" 
                                           Foreground="#4B5563" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Real-Time Action Overlay HUD -->
                                <Border x:Name="PnlActionOverlay" VerticalAlignment="Bottom" Background="#DD0D0F14" CornerRadius="0,0,6,6" Padding="8,4" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="BadgeOverlayAction" Background="#374151" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock x:Name="TxtOverlayAction" Text="IDLE" FontSize="10" FontWeight="Black" Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock x:Name="TxtOverlayStats" Text="Target: -- | Err: 0px" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="BadgeOverlayMouse" Background="#1F2937" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtOverlayMouse" Text="MOUSE UP" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 4. SETTINGS & FOOTER -->
                <Border Grid.Row="4" Background="#171A23" BorderBrush="#252A38" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <Expander x:Name="ExpanderSettings" Background="Transparent" BorderThickness="0" IsExpanded="False"
                              Expanded="ExpanderSettings_Expanded" Collapsed="ExpanderSettings_Collapsed">
                        <Expander.Header>
                            <TextBlock Text="⚙ CONFIGURATION &amp; TUNING" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Basic Rod & Dynamic Vision Auto-Release -->
                                <RowDefinition Height="Auto"/> <!-- Row 1: Auto-Shake Mode -->
                                <RowDefinition Height="Auto"/> <!-- Row 2: Anti-AFK & Timing Jitter -->
                                <RowDefinition Height="Auto"/> <!-- Row 3: Aquarium Auto-Claim -->
                                <RowDefinition Height="Auto"/> <!-- Row 4: Auto-Open Crates -->
                                <RowDefinition Height="Auto"/> <!-- Row 5: Hotkeys -->
                                <RowDefinition Height="Auto"/> <!-- Row 6: Save Config Button -->
                            </Grid.RowDefinitions>

                            <!-- ROW 0: ROD & CAST SETTINGS -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <!-- Rod Slot -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="ROD SLOT" Style="{StaticResource MetricLabel}"/>
                                    <TextBox x:Name="TxtRodSlot" Text="1" Height="30" FontSize="11" TextAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Predictive Lead -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="CAST LEAD (MS)" Style="{StaticResource MetricLabel}" ToolTip="Adjust the auto-cast predictive release delay. 25ms is default. Tuning this helps hit 100% perfects."/>
                                    <TextBox x:Name="TxtCastLead" Text="25" Height="30" FontSize="11" TextAlignment="Center" Margin="0,2,0,0" ToolTip="Adjust the auto-cast predictive release delay. 25ms is default. Tuning this helps hit 100% perfects."/>
                                </StackPanel>

                                <!-- Minigame Theme -->
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="MINIGAME THEME" Style="{StaticResource MetricLabel}"/>
                                    <ComboBox x:Name="CmbMinigameTheme" SelectionChanged="CmbMinigameTheme_SelectionChanged" Height="30" FontSize="11" Margin="0,2,0,0">
                                        <ComboBoxItem Content="Auto-Calibrate (Default)" IsSelected="True"/>
                                        <ComboBoxItem Content="Default (White/Slate Blue)"/>
                                        <ComboBoxItem Content="Feline (Pink)"/>
                                        <ComboBoxItem Content="Trident (Green)"/>
                                        <ComboBoxItem Content="Golden"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Post-Catch Delay -->
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="POST-CATCH (MS)" Style="{StaticResource MetricLabel}"/>
                                    <TextBox x:Name="TxtPostCatch" Text="1500" Height="30" FontSize="11" TextAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ROW 1: AUTO-SHAKE MODE -->
                            <Border Grid.Row="1" Background="#0F121A" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="#1F2535" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚡ SHAKE MODE:" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbShakeMode" Grid.Column="1" SelectionChanged="CmbShakeMode_SelectionChanged"
                                              Height="28" FontSize="11">
                                        <ComboBoxItem Content="Visual (Auto-Click Icon)" IsSelected="True" ToolTip="Detects and clicks the popping shake circles"/>
                                        <ComboBoxItem Content="UI Navigation (Key Shake)" ToolTip="Uses Roblox UI Navigation and Enter keypresses"/>
                                        <ComboBoxItem Content="Disabled" ToolTip="Disables auto-shake"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- ROW 2: AUTOMATION & SAFETY TOGGLES -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Anti-AFK Kick -->
                                <Border Grid.Column="0" Background="#0F121A" CornerRadius="6" Padding="8,6" Margin="0,0,4,0" BorderBrush="#1F2535" BorderThickness="1">
                                    <CheckBox x:Name="ChkAntiAfk" Content="🛡️ Anti-AFK Kick" IsChecked="True"
                                              Checked="ChkAntiAfk_Changed" Unchecked="ChkAntiAfk_Changed"
                                              Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Micro-resets Roblox's 20-minute idle disconnect timer without moving your camera"/>
                                </Border>

                                <!-- Human Jitter -->
                                <Border Grid.Column="1" Background="#0F121A" CornerRadius="6" Padding="8,6" Margin="4,0,0,0" BorderBrush="#1F2535" BorderThickness="1">
                                    <CheckBox x:Name="ChkJitter" Content="🎲 Human Jitter" IsChecked="True"
                                              Checked="ChkJitter_Changed" Unchecked="ChkJitter_Changed"
                                              Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Adds realistic ±8ms micro-variance to cast hold and click timings to prevent detection"/>
                                </Border>
                            </Grid>

                            <!-- ROW 3: AQUARIUM AUTO-CLAIM -->
                            <Border Grid.Row="3" Background="#0F121A" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" BorderBrush="#1F2535" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkAutoClaimAquarium" Content="🏆 Auto-Claim Aquarium" IsChecked="True"
                                              Checked="ChkAutoClaimAquarium_Changed" Unchecked="ChkAutoClaimAquarium_Changed"
                                              Foreground="#34D399" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Automatically retrieves Personal Aquarium hourly profits (C$ + XP) between catches"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Every:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtAquariumInterval" Text="60" Width="38" Height="25" FontSize="11" FontWeight="SemiBold" Padding="1,0" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0" ToolTip="Minutes between aquarium claims"/>
                                        <TextBlock Text="m" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnTestClaim" Click="BtnClaimAquarium_Click" Content="Claim Now"
                                                Background="#064E3B" Foreground="#34D399" BorderBrush="#10B981" BorderThickness="1"
                                                FontSize="9" FontWeight="Bold" Padding="6,2" Cursor="Hand" ToolTip="Test Aquarium claim sequence immediately"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ROW 4: AUTO-OPEN CRATES ('G' INVENTORY) -->
                            <Border Grid.Row="4" Background="#0F121A" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" BorderBrush="#1F2535" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkAutoOpenCrates" Content="📦 Auto-Open Crates ('g')" IsChecked="False"
                                              Checked="ChkAutoOpenCrates_Changed" Unchecked="ChkAutoOpenCrates_Changed"
                                              Foreground="#FBBF24" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Unequips rod, opens Equipment ('g'), searches 'crate', unpacks all available crates, and re-equips rod"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Every:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBox x:Name="TxtCrateInterval" Text="15" Width="30" Height="25" FontSize="11" FontWeight="SemiBold" Padding="1,0" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,2,0" ToolTip="Catches between crate unpacks"/>
                                        <TextBlock Text="c" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="catches"/>
                                        <TextBlock Text="Max:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox x:Name="TxtCrateMaxTypes" Text="0" Width="30" Height="25" FontSize="11" FontWeight="SemiBold" Padding="1,0" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,2,0" ToolTip="Max crate types to unpack (0 = All until empty, or specify a limit)"/>
                                        <TextBlock Text="types" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button x:Name="BtnTestOpenCrates" Click="BtnOpenCrates_Click" Content="Open Now"
                                                Background="#2E1B0E" Foreground="#FBBF24" BorderBrush="#D97706" BorderThickness="1"
                                                FontSize="9" FontWeight="Bold" Padding="6,2" Cursor="Hand" ToolTip="Unequips rod, opens Equipment ('g'), searches 'crate', unpacks all crates, and re-equips rod"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ROW 5: HOTKEYS -->
                            <Grid Grid.Row="5" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="START/STOP" Style="{StaticResource MetricLabel}"/>
                                    <ComboBox x:Name="CmbToggleKey" Height="30" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0">
                                        <ComboBoxItem Content="F6" IsSelected="True"/>
                                        <ComboBoxItem Content="F7"/>
                                        <ComboBoxItem Content="F8"/>
                                        <ComboBoxItem Content="F4"/>
                                        <ComboBoxItem Content="Insert"/>
                                        <ComboBoxItem Content="Home"/>
                                        <ComboBoxItem Content="Pause"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="RE-EQUIP" Style="{StaticResource MetricLabel}"/>
                                    <ComboBox x:Name="CmbReEquipKey" Height="30" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0">
                                        <ComboBoxItem Content="F7" IsSelected="True"/>
                                        <ComboBoxItem Content="F8"/>
                                        <ComboBoxItem Content="F6"/>
                                        <ComboBoxItem Content="F4"/>
                                        <ComboBoxItem Content="Insert"/>
                                        <ComboBoxItem Content="Home"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EMERGENCY" Style="{StaticResource MetricLabel}"/>
                                    <TextBox Text="[End]" IsReadOnly="True" Height="30" Foreground="#9CA3AF" FontSize="11" TextAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ROW 6: SAVE CONFIG BUTTON (Full Width) -->
                            <Button x:Name="BtnSaveSettings" Grid.Row="6" Content="💾 Save Configuration" Click="BtnSaveSettings_Click"
                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Black" FontSize="12" Height="34" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Expander>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 5. FULL MASCOT SPLASH SCREEN OVERLAY -->
        <Grid x:Name="OverlaySplash" Grid.RowSpan="5" Margin="-16" Background="#EE090C12" 
              MouseLeftButtonDown="OverlaySplash_MouseLeftButtonDown" Cursor="Hand" Visibility="Visible">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" 
                    Background="#0D111A" BorderBrush="#222C40" BorderThickness="1.5" CornerRadius="20" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.95" ShadowDepth="12"/>
                </Border.Effect>
                <StackPanel Orientation="Vertical">
                    <!-- Full Mascot Artwork -->
                    <Border CornerRadius="16" BorderBrush="#1F283A" BorderThickness="1.5" Background="#070A0F" ClipToBounds="True" Height="330" Margin="0,0,0,14">
                        <Grid>
                            <Image Source="splash_logo.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border VerticalAlignment="Bottom" Height="40">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000D111A" Offset="0.0"/>
                                        <GradientStop Color="#E60D111A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <TextBlock Text="FAT DAD'S" FontSize="25" FontWeight="Black" Foreground="#00E5FF" Margin="0,0,8,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#00E5FF" Opacity="0.45" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="FISCH AFK PRO" FontSize="25" FontWeight="Black" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <TextBlock Text="AUTONOMOUS KINETIC ANGLER • ROBLOX FISCH" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Adaptive multi-rod kinetic model &amp; high-frequency vision" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Status & Dismiss hint -->
                    <Border Background="#121722" CornerRadius="10" Padding="14,8" BorderBrush="#1A2230" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="#10B981" Opacity="0.8" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock x:Name="TxtSplashStatus" Text="Calibrating Multi-Rod Kinetic Model..." FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock Text="Click anywhere to continue ➔" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
