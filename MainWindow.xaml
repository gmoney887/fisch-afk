<Window x:Class="FischMacroCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fat Dad's Fisch AFK Pro v1.0.0" Height="850" Width="490" MinHeight="500" MinWidth="380"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Icon="Assets/angler.ico"
        Background="#090E17" Foreground="#E7EDF7" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Shared secondary actions: consistent sizing and visible interaction states. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2A40"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#30445F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#2C3C52"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#7DD3FC"/>
                                <Setter TargetName="ActionBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#0F3854"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Static dashboard controls retain native keyboard and automation behavior. -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel x:Name="SwitchRoot" Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="26" Height="15" CornerRadius="7.5" Background="#26364D" BorderBrush="#455975" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse x:Name="Thumb" Width="9" Height="9" Fill="#A2B2C9" HorizontalAlignment="Left" Margin="2,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#087E88"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#5EEAD4"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#ECFEFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#A5F3FC"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchRoot" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#A8BAD3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{TemplateBinding Foreground}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="DisclosureBorder" Background="Transparent" CornerRadius="5" Padding="2,6">
                                            <DockPanel>
                                                <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="#6B88AC" StrokeThickness="1.5" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 0,0 L 4,4 L 8,0"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DisclosureBorder" Property="Background" Value="#1B2A40"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DisclosureBorder" Property="Background" Value="#24405A"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#111B2B"/>
            <Setter Property="BorderBrush" Value="#24334A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Metric Label Style -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Metric Value Style -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Modern Dark ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="templateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="true">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <!-- Dropdown Arrow -->
                    <Path x:Name="arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="#94A3B8"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#161B26"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#00E5FF"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#00E5FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Dark ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="2,1"
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2A40"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#0F3854"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true"/>
                                    <Condition Property="IsMouseOver" Value="true"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox Global Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#0F1117"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D3344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="1"
                                   PopupAnimation="Fade"
                                   Placement="Bottom">
                                <Border x:Name="dropDownBorder"
                                        Background="#0E121B"
                                        BorderBrush="#2D3344"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinHeight="30"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        Padding="3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.85" ShadowDepth="6"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" Focusable="False">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}"/>

                            <ContentPresenter x:Name="contentPresenter"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="false"
                                              Margin="10,4,28,4"
                                              ClipToBounds="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox Global Style -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0F1117"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D3344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Session Analytics HUD -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Status & Main Control -->
                    <RowDefinition Height="Auto"/> <!-- Row 3: Pre-Flight Diagnostic Results -->
                    <RowDefinition Height="Auto"/> <!-- Row 4: Vision Camera Preview -->
                    <RowDefinition Height="Auto"/> <!-- Row 5: Settings & Footer -->
                </Grid.RowDefinitions>

                <!-- 1. HEADER -->
                <Border Grid.Row="0" BorderBrush="#25465C" BorderThickness="1" CornerRadius="12" Padding="12,12" Margin="0,0,0,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16374A" Offset="0"/>
                            <GradientStop Color="#111C30" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="0,0,0,6" ClipToBounds="True">
                            <!-- A static low-poly fishing scene adds character without a render loop. -->
                            <Viewbox Width="140" Height="104" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.75" IsHitTestVisible="False">
                                <Canvas Width="220" Height="136">
                                    <Ellipse Width="40" Height="40" Fill="#BAF5E9" Canvas.Left="157" Canvas.Top="8"/>
                                    <Path Data="M 20,94 L 73,45 L 107,82 L 146,60 L 210,103 Z" Fill="#21465A"/>
                                    <Path Data="M 73,45 L 84,81 L 107,82 Z M 146,60 L 157,92 L 210,103 Z" Fill="#356A71"/>
                                    <Path Data="M 0,104 L 220,104 220,136 0,136 Z" Fill="#12394F"/>
                                    <Path Data="M 12,116 L 70,116 M 127,123 L 204,123 M 160,110 L 191,110" Stroke="#4595A2" StrokeThickness="2"/>
                                    <Path Data="M 47,92 L 125,92 125,100 47,100 Z M 55,100 L 55,126 M 114,100 L 114,125" Stroke="#74999A" Fill="#496F7B" StrokeThickness="3"/>
                                    <Rectangle Width="13" Height="13" Fill="#BDEBCF" Canvas.Left="83" Canvas.Top="59"/>
                                    <Path Data="M 82,74 L 96,74 101,92 79,92 Z" Fill="#50CDB7"/>
                                    <Path Data="M 95,79 L 110,73 128,47 M 128,47 Q 155,51 170,101" Stroke="#D5F8E4" StrokeThickness="2"/>
                                    <Rectangle Width="4" Height="5" Fill="#E6BD74" Canvas.Left="168" Canvas.Top="100"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Image Source="Assets/angler.png" Width="22" Height="22" Margin="0,0,7,0" Cursor="Hand" MouseLeftButtonDown="Avatar_MouseLeftButtonDown" ToolTip="View mascot"/>
                                    <TextBlock Text="FAT DAD'S" Foreground="#8DB6CC" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="FISCH AFK" FontSize="30" FontWeight="Black" Foreground="#F0FBFF"/>
                                <TextBlock Text="Your next catch. On autopilot." FontSize="11" Foreground="#A8C8D9" Margin="0,1,0,10"/>
                                <WrapPanel>
                                    <Border Background="#143D49" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                        <TextBlock x:Name="TxtHeaderHotkey" Text="[F6] START/STOP" FontSize="9" FontWeight="Bold" Foreground="#7AE9DB"/>
                                    </Border>
                                    <TextBlock x:Name="TxtAppVersionBadge" Text="v1.0.0 PRO" FontSize="9" Foreground="#86A3BD" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Update Notification Banner (Hidden by default, shown when newer GitHub release detected) -->
                        <Border x:Name="BorderUpdateBanner" Visibility="Collapsed" Background="#0C2E24" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,4.5" Margin="0,6,0,0" Cursor="Hand" MouseLeftButtonDown="BorderUpdateBanner_MouseLeftButtonDown" ToolTip="Click to open GitHub download page">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="🚀" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Download ➔" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                <TextBlock x:Name="TxtUpdateBanner" Text="Update Available — Click to download" FontSize="10" FontWeight="SemiBold" Foreground="#A7F3D0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>

                        <!-- CATEGORIZED ACTION TOOLBARS -->
                        <StackPanel Margin="0,10,0,0">
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CATEGORY 1: DISPLAY & WINDOW OPTIONS (Display Only) -->
                            <Border Grid.Row="0" Background="#0C0F17" BorderBrush="#1C2333" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,5">
                                <DockPanel LastChildFill="True">
                                    <Border Background="#161F30" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <TextBlock Text="VIEW" FontSize="8.5" FontWeight="Black" Foreground="#38BDF8" VerticalAlignment="Center" ToolTip="Display &amp; window layout options only (Safe anytime)"/>
                                    </Border>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="BtnSnapSideBySide" Click="BtnSnapSideBySide_Click" Content="Split screen" Margin="0,0,4,2"
                                                ToolTip="Display Option: Arrange Roblox on left and Angler on right with zero overlap">
                                        </Button>

                                        <Button x:Name="BtnWindowed" Click="BtnWindowed_Click" Content="Windowed" Margin="0,0,4,2"
                                                ToolTip="Display Option: Roblox expands windowed while Angler floats in top-right corner">
                                        </Button>

                                        <Border Background="#131824" BorderBrush="#252C3E" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,4,2" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkAlwaysOnTop" Content="Pin on top" IsChecked="True"
                                                      Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed"
                                                      Foreground="#CBD5E1" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"
                                                      ToolTip="Display Option: Keep macro window topmost over other windows"/>
                                        </Border>




                                    </WrapPanel>
                                </DockPanel>
                            </Border>

                            <!-- CATEGORY 2: STANDALONE TASKS (Requires NOT to be fishing) -->
                            <Border Grid.Row="1" Background="#0C0F17" BorderBrush="#26221A" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0">
                                        <Border Background="#2B1E0C" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="LOOT" FontSize="8.5" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="TxtTasksIdleBadge" Text="Idle" FontSize="8" Foreground="#64748B" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="BtnClaimAquarium" Click="BtnClaimAquarium_Click" Content="Claim aquarium" Margin="0,0,4,0" ToolTip="Requires NOT Fishing: Opens Aquarium, claims hourly profit (C$ + XP), and returns">
                                        </Button>

                                        <Button x:Name="BtnOpenCrates" Click="BtnOpenCrates_Click" Content="Open crates" Margin="0,0,0,0" ToolTip="Requires NOT Fishing: Unequips rod, opens Equipment ('g'), searches 'crate', unpacks all crates, and re-equips rod">
                                        </Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. SESSION ANALYTICS CARD -->
                <Border Grid.Row="2" Background="#101B2B" BorderBrush="#1F283D" BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Reset Button -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                            <Button x:Name="BtnResetStats" Click="BtnResetStats_Click" Content="↺ Reset" DockPanel.Dock="Right" MinHeight="26" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Reset session counters without stopping fishing"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="THIS SESSION" FontSize="9" FontWeight="Black" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtStreakBadge" Text="🔥 Streak: 0" FontSize="9" FontWeight="Bold" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Border x:Name="BadgeWatchdog" Background="#0C1929" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Recovery attempts started after a timeout or stall; includes interrupted attempts. Missed cast meters alone do not trigger a retry.">
                                    <TextBlock x:Name="TxtWatchdogBadge" Text="🛡️ Retries: 0" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                            </WrapPanel>
                        </DockPanel>

                        <!-- 4 Stat Badges Grid -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Stat 1: Total Catches -->
                            <Border Grid.Column="0" Background="#142337" BorderBrush="#253C56" BorderThickness="1" CornerRadius="8" Padding="4,8" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CATCHES" FontSize="8" FontWeight="Black" Foreground="#91A8C4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTotalCatches" Text="0" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat 2: Catches Per Hour -->
                            <Border Grid.Column="1" Background="#142337" BorderBrush="#253C56" BorderThickness="1" CornerRadius="8" Padding="4,8" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CATCHES / HR" FontSize="8" FontWeight="Black" Foreground="#91A8C4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCatchRate" Text="0.0/hr" FontSize="21" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat 3: Win Rate -->
                            <Border Grid.Column="2" Background="#142337" BorderBrush="#253C56" BorderThickness="1" CornerRadius="8" Padding="4,8" Margin="0,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="WIN RATE" FontSize="8" FontWeight="Black" Foreground="#91A8C4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWinRate" Text="100%" FontSize="21" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Stat 4: Session Uptime -->
                            <Border Grid.Column="3" Background="#142337" BorderBrush="#253C56" BorderThickness="1" CornerRadius="8" Padding="4,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="TIME FISHING" FontSize="8" FontWeight="Black" Foreground="#91A8C4" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSessionUptime" Text="00:00:00" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. STATUS & CONTROLS CARD -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Primary Action: Start / Stop Fishing & Pre-Flight -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Big Start/Stop Fishing Button (Automatically equips rod upon start) -->
                            <Button Grid.Row="0" x:Name="BtnToggle" Click="BtnToggle_Click" Cursor="Hand"
                                    ToolTip="First stop press finishes the current fishing cycle. Press again to stop immediately; End is the emergency stop.">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="#10B981" CornerRadius="8" Padding="8,12">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="txtBtnState" Text="START FISHING" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock x:Name="txtBtnSub" Text="Press F6" FontSize="9.5" FontWeight="SemiBold" Foreground="#D1FAE5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Pre-Flight Diagnostic Button -->
                            <Button Grid.Column="1" Content="Check readiness" x:Name="BtnPreFlight" Click="BtnPreFlight_Click" Margin="8,0,0,0"
                                    ToolTip="Runs rapid 4-second pre-flight diagnostic: verifies Roblox window, capture latency, hotbar OpenCV vision, and performs live tool toggle probe">
                            </Button>
                        </Grid>

                        <!-- Live Telemetry (2 Columns with clean spacing) -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- State Badge & Rod Vision Badge -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                <TextBlock Text="STATUS" Style="{StaticResource MetricLabel}"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Border x:Name="BadgeState" Background="#374151" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="TxtState" Text="READY" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    </Border>
                                    <Border x:Name="BadgeRodState" Background="#111622" BorderBrush="#1C2638" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" ToolTip="Live Computer Vision status of fishing rod in hand">
                                        <TextBlock x:Name="TxtRodState" Text="ROD: STANDBY" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Action Text -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock Text="RIGHT NOW" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtAction" Text="Idle" Style="{StaticResource MetricValue}" FontSize="11" Foreground="#00E5FF" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                <TextBlock Text="CATCH TRACKING" Style="{StaticResource MetricLabel}" Foreground="#7AE9DB"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <!-- Catch Bar -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                <TextBlock Text="CATCH BAR" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtBarPos" Text="Waiting..." Style="{StaticResource MetricValue}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Fish Needle -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock Text="FISH NEEDLE" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TxtFishPos" Text="Waiting..." Style="{StaticResource MetricValue}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Latency & Rod Acceleration Bar -->
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0D1017" CornerRadius="4" Padding="6,3" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtLatency" Text="Vision: -- | Loop: --" Style="{StaticResource MetricValue}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- PRE-FLIGHT DIAGNOSTIC RESULTS (Condensed strip by default, expandable on demand or issue) -->
                <Border Grid.Row="3" x:Name="BorderPreFlightResults" Visibility="Collapsed" Background="#0C101A" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="6" Padding="6,5" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Condensed Verdict Banner (Status + Time + Details Toggle + Dismiss) -->
                        <Border Grid.Row="0" x:Name="BannerPreFlightVerdict" Background="#0C2E24" BorderBrush="#10B981" BorderThickness="1" CornerRadius="5" Padding="8,4">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="TxtPreFlightVerdictIcon" Text="✅" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPreFlightDuration" Text="(0.5s)" FontSize="8.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnTogglePreFlightDetails" Click="BtnTogglePreFlightDetails_Click" Content="Details ▾" ToolTip="Expand/collapse detailed test breakdown" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnClosePreFlight" Click="BtnClosePreFlight_Click" Content="✕" ToolTip="Dismiss diagnostic banner"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtPreFlightVerdict" Text="5/5 SYSTEMS NOMINAL — READY TO FISH 🎣" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>

                        <!-- 5 Steps Checklist (Collapsed by default when all nominal; automatically shown if any issue occurs) -->
                        <StackPanel Grid.Row="1" x:Name="PanelPreFlightSteps" Visibility="Collapsed" Margin="0,6,0,0">
                            <!-- Step 1: Window -->
                            <Border x:Name="StepItemWindow" Background="#111622" BorderBrush="#1C2638" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="IconStepWindow" Text="⏳" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="MetricStepWindow" Text="Pending..." FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Roblox Window &amp; Resolution" FontSize="10" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                        <TextBlock x:Name="DescStepWindow" Text="Checking for active Roblox client..." FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Step 2: Capture -->
                            <Border x:Name="StepItemCapture" Background="#111622" BorderBrush="#1C2638" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="IconStepCapture" Text="⏳" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="MetricStepCapture" Text="Pending..." FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Screen Capture Latency Benchmark" FontSize="10" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                        <TextBlock x:Name="DescStepCapture" Text="Measuring BitBlt latency (target sub-3ms)..." FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Step 3: Hotbar -->
                            <Border x:Name="StepItemHotbar" Background="#111622" BorderBrush="#1C2638" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="IconStepHotbar" Text="⏳" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="MetricStepHotbar" Text="Pending..." FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Dynamic Hotbar &amp; Slot Discovery" FontSize="10" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                        <TextBlock x:Name="DescStepHotbar" Text="Locating CoreGui hotbar container..." FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Step 4: Tool Toggle Probe -->
                            <Border x:Name="StepItemToggle" Background="#111622" BorderBrush="#1C2638" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="IconStepToggle" Text="⏳" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="MetricStepToggle" Text="Pending..." FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Live Momentary Tool Toggle Probe" FontSize="10" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                        <TextBlock x:Name="DescStepToggle" Text="Sending momentary '1' keypress and verifying CV detection..." FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Step 5: Coordinate Safety Audit -->
                            <Border x:Name="StepItemSafety" Background="#111622" BorderBrush="#1C2638" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="IconStepSafety" Text="⏳" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="MetricStepSafety" Text="Pending..." FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Coordinate Boundary &amp; Safety Audit" FontSize="10" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                        <TextBlock x:Name="DescStepSafety" Text="Auditing water target, slot click, and dialog coordinates..." FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. LIVE OPENCV VISION CAMERA FEED (COMPACT MONITOR - ZERO WASTED SPACE) -->
                <Border Grid.Row="4" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="GAME VIEW" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRecordingIndicator" Text="● REC" FontSize="10" Foreground="#EF4444" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="BtnObserve" Content="Record my play" Click="Observe_Click" Margin="0,0,8,6" ToolTip="Record your manual gameplay without automated inputs. End stops recording."/>
                                <CheckBox x:Name="ChkEnableRecording" Content="Save clips" IsChecked="True" Foreground="#CBD5E1" FontSize="11" Margin="0,0,8,6" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkShowPreview" Content="Live camera" Click="ChkShowPreview_Click" ToolTip="Enable live vision while fishing or observing. Turns off AFK Performance." IsChecked="True" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,6" VerticalAlignment="Center"/>
                            </WrapPanel>
<WrapPanel Margin="0,0,0,6"><Button x:Name="BtnOpenRecordings" Click="BtnOpenRecordings_Click" Content="My clips" Margin="0,0,4,2" ToolTip="Display Option: Open recorded fish catch clips folder in Explorer">
                                        </Button>
<Button x:Name="BtnSubmitRecording" Click="BtnSubmitRecording_Click" Content="Share diagnostics" Margin="0,0,0,2" ToolTip="Diagnostic Option: Submit or export recording bundle with telemetry &amp; logs to review and correct issues">
                                        </Button></WrapPanel>
                            <Expander Header="Recording options" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Record my play captures manual gameplay. Press End to stop." TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                            <TextBlock Text="Keep sessions:" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="TxtMaxRecordings" Text="25" Width="44" Height="30" TextAlignment="Center" ToolTip="Maximum number of saved recording sessions"/>
                                        </StackPanel>

                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- Camera stays visible; frame generation remains throttled in the engine. -->
                        <Expander x:Name="ExpanderPreview" Grid.Row="1" Header="Camera feed" IsExpanded="True" Margin="0,4,0,0">
                        <Border Background="#0A0C10" CornerRadius="6" BorderBrush="#1C202C" BorderThickness="1" Height="170" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPreviewPlaceholder" Text="Waiting for frames — start fishing or select Record my play."
                                           Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>

                                <!-- Real-Time Action Overlay HUD -->
                                <Border x:Name="PnlActionOverlay" VerticalAlignment="Bottom" Background="#DD0D0F14" CornerRadius="0,0,6,6" Padding="8,4" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="BadgeOverlayAction" Background="#374151" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock x:Name="TxtOverlayAction" Text="IDLE" FontSize="10" FontWeight="Black" Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock x:Name="TxtOverlayStats" Text="Target: -- | Err: 0px" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="BadgeOverlayMouse" Background="#1F2937" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtOverlayMouse" Text="MOUSE UP" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        </Expander>
                    </Grid>
                </Border>

                <!-- 5. SETTINGS & FOOTER -->
                <Border Grid.Row="5" Background="#111B2B" BorderBrush="#24334A" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <StackPanel>
                    <CheckBox x:Name="ChkAfkPerformance" Content="AFK Performance" Margin="0,0,0,8"
                              Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="11"
                              Checked="ChkAfkPerformance_Changed" Unchecked="ChkAfkPerformance_Changed"
                              ToolTip="Faster fishing with visual readiness checks. Disables preview and artificial timing jitter; keeps recording and Pin on top enabled. Restores preview and jitter preferences when switched off. Fisch appearance settings are separate: turn off Show Catch Flags, other players' fish and lanterns, and environment tints; set VFX Visibility to Hide All."/>
                    <Expander x:Name="ExpanderSettings" Background="Transparent" BorderThickness="0" IsExpanded="False"
                              Expanded="ExpanderSettings_Expanded" Collapsed="ExpanderSettings_Collapsed">
                        <Expander.Header>
                            <TextBlock Text="My fishing setup" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Basic Rod & Dynamic Vision Auto-Release -->
                                <RowDefinition Height="Auto"/> <!-- Row 1: Auto-Shake Mode -->
                                <RowDefinition Height="Auto"/> <!-- Row 2: Anti-AFK & Timing Jitter -->
                                <RowDefinition Height="Auto"/> <!-- Row 3: Aquarium Auto-Claim -->
                                <RowDefinition Height="Auto"/> <!-- Row 4: Auto-Open Crates -->
                                <RowDefinition Height="Auto"/> <!-- Row 5: Hotkeys -->
                                <RowDefinition Height="Auto"/> <!-- Row 6: Save Config Button -->
                                <RowDefinition Height="Auto"/> <!-- Row 7: Version -->
                            </Grid.RowDefinitions>

                            <!-- ROW 0: ROD & CAST SETTINGS -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <!-- Rod Slot -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="ROD SLOT" Style="{StaticResource MetricLabel}"/>
                                    <TextBox x:Name="TxtRodSlot" Text="1" Height="30" FontSize="11" TextAlignment="Center" Margin="0,2,0,0"
                                             TextChanged="TxtRodSlot_TextChanged" LostFocus="TxtRodSlot_LostFocus"/>
                                </StackPanel>

                                <!-- Predictive Lead -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,10">
                                    <TextBlock Text="CAST LEAD (MS)" Style="{StaticResource MetricLabel}" ToolTip="Adjust the auto-cast predictive release delay. 25ms is default. Adjust only when comparing recorded cast results."/>
                                    <TextBox x:Name="TxtCastLead" Text="25" Height="30" FontSize="11" TextAlignment="Center" Margin="0,2,0,0" ToolTip="Adjust the auto-cast predictive release delay. 25ms is default. Adjust only when comparing recorded cast results."/>
                                </StackPanel>

                                <!-- Minigame Theme -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="MINIGAME THEME" Style="{StaticResource MetricLabel}"/>
                                    <ComboBox x:Name="CmbMinigameTheme" SelectionChanged="CmbMinigameTheme_SelectionChanged" Height="30" FontSize="11" Margin="0,2,0,0">
                                        <ComboBoxItem Content="Auto (default)" IsSelected="True"/>
                                        <ComboBoxItem Content="White / slate"/>
                                        <ComboBoxItem Content="Feline (Pink)"/>
                                        <ComboBoxItem Content="Trident (Green)"/>
                                        <ComboBoxItem Content="Golden"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Post-Catch Delay -->
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="POST-CATCH (MS)" Style="{StaticResource MetricLabel}"/>
                                    <TextBox x:Name="TxtPostCatch" Text="1500" Height="30" FontSize="11" TextAlignment="Center" Margin="0,2,0,0"/>
                                    <CheckBox x:Name="ChkAdaptiveDynamics" Content="Adaptive dynamics (trial)" Foreground="#94A3B8" FontSize="10" Margin="0,4,0,0" Checked="AdaptiveDynamicsChanged" Unchecked="AdaptiveDynamicsChanged" ToolTip="Experimental bounded pull/release tuning. Compare matched live sessions on both PCs before enabling for unattended use."/>
                                </StackPanel>
                            </Grid>

                            <!-- ROW 1: AUTO-SHAKE MODE -->
                            <Border Grid.Row="1" Background="#0F121A" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="#1F2535" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚡ SHAKE MODE:" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbShakeMode" Grid.Column="1" SelectionChanged="CmbShakeMode_SelectionChanged"
                                              Height="28" FontSize="11">
                                        <ComboBoxItem Content="Visual (Auto-Click Icon)" IsSelected="True" ToolTip="Detects and clicks the popping shake circles"/>
                                        <ComboBoxItem Content="UI Navigation (Key Shake)" ToolTip="Uses Roblox UI Navigation and Enter keypresses"/>
                                        <ComboBoxItem Content="Disabled" ToolTip="Disables auto-shake"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- ROW 2: AUTOMATION & SAFETY TOGGLES -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <!-- Anti-AFK Kick -->
                                <Border Grid.Column="0" Background="#0F121A" CornerRadius="6" Padding="4,6" Margin="0,0,2,0" BorderBrush="#1F2535" BorderThickness="1">
                                    <CheckBox x:Name="ChkAntiAfk" Content="🛡️ Anti-AFK" IsChecked="True"
                                              Checked="ChkAntiAfk_Changed" Unchecked="ChkAntiAfk_Changed"
                                              Foreground="#CBD5E1" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Sends periodic nonmoving input to reduce idle disconnects; server disconnects can still occur"/>
                                </Border>

                                <!-- Human Jitter -->
                                <Border Grid.Column="1" Background="#0F121A" CornerRadius="6" Padding="4,6" Margin="2,0,2,0" BorderBrush="#1F2535" BorderThickness="1">
                                    <CheckBox x:Name="ChkJitter" Content="🎲 Jitter" IsChecked="True"
                                              Checked="ChkJitter_Changed" Unchecked="ChkJitter_Changed"
                                              Foreground="#CBD5E1" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Adds realistic micro-variance to cast hold and click timings to vary input timing"/>
                                </Border>

                                <!-- Auto Pre-Flight -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#0F121A" CornerRadius="6" Padding="4,6" Margin="2,0,2,0" BorderBrush="#1F2535" BorderThickness="1">
                                    <CheckBox x:Name="ChkAutoPreFlight" Content="🩺 Pre-Flight" IsChecked="True"
                                              Checked="ChkAutoPreFlight_Changed" Unchecked="ChkAutoPreFlight_Changed"
                                              Foreground="#CBD5E1" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Automatically runs rapid Pre-Flight health check when Start Fishing is clicked"/>
                                </Border>

                                <!-- Self-Healing Watchdog -->
                                <Border Grid.Row="1" Grid.Column="1" Background="#0F121A" CornerRadius="6" Padding="4,6" Margin="2,0,0,0" BorderBrush="#1F2535" BorderThickness="1">
                                    <CheckBox x:Name="ChkWatchdog" Content="🔄 Watchdog" IsChecked="True"
                                              Checked="ChkWatchdog_Changed" Unchecked="ChkWatchdog_Changed"
                                              Foreground="#38BDF8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Autonomous Self-Healing: monitors fishing progress, clears stalls, and automatically restarts"/>
                                </Border>
                            </Grid>

                            <!-- ROW 3: AQUARIUM AUTO-CLAIM -->
                            <Border Grid.Row="3" Background="#0F121A" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" BorderBrush="#1F2535" BorderThickness="1">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAutoClaimAquarium" Content="🏆 Auto-Claim Aquarium" IsChecked="True"
                                              Checked="ChkAutoClaimAquarium_Changed" Unchecked="ChkAutoClaimAquarium_Changed"
                                              Foreground="#34D399" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Automatically retrieves Personal Aquarium hourly profits (C$ + XP) between catches"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="Every:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtAquariumInterval" Text="60" Width="38" Height="25" FontSize="11" FontWeight="SemiBold" Padding="1,0" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0" ToolTip="Minutes between aquarium claims"/>
                                        <TextBlock Text="m" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnTestClaim" Click="BtnClaimAquarium_Click" Content="Claim Now" ToolTip="Test Aquarium claim sequence immediately"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ROW 4: AUTO-OPEN CRATES ('G' INVENTORY) -->
                            <Border Grid.Row="4" Background="#0F121A" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" BorderBrush="#1F2535" BorderThickness="1">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAutoOpenCrates" Content="📦 Auto-Open Crates ('g')" IsChecked="False"
                                              Checked="ChkAutoOpenCrates_Changed" Unchecked="ChkAutoOpenCrates_Changed"
                                              Foreground="#FBBF24" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                              ToolTip="Unequips rod, opens Equipment ('g'), searches 'crate', unpacks all available crates, and re-equips rod"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="Every:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBox x:Name="TxtCrateInterval" Text="15" Width="30" Height="25" FontSize="11" FontWeight="SemiBold" Padding="1,0" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,2,0" ToolTip="Catches between crate unpacks"/>
                                        <TextBlock Text="c" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="catches"/>
                                        <TextBlock Text="Max:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBox x:Name="TxtCrateMaxTypes" Text="0" Width="30" Height="25" FontSize="11" FontWeight="SemiBold" Padding="1,0" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,2,0" ToolTip="Max crate types to unpack (0 = All until empty, or specify a limit)"/>
                                        <TextBlock Text="types" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button x:Name="BtnTestOpenCrates" Click="BtnOpenCrates_Click" Content="Open Now" ToolTip="Unequips rod, opens Equipment ('g'), searches 'crate', unpacks all crates, and re-equips rod"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ROW 5: HOTKEYS -->
                            <Grid Grid.Row="5" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="START/STOP" Style="{StaticResource MetricLabel}"/>
                                    <ComboBox x:Name="CmbToggleKey" Height="30" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0">
                                        <ComboBoxItem Content="F6" IsSelected="True"/>
                                        <ComboBoxItem Content="F7"/>
                                        <ComboBoxItem Content="F8"/>
                                        <ComboBoxItem Content="F4"/>
                                        <ComboBoxItem Content="Insert"/>
                                        <ComboBoxItem Content="Home"/>
                                        <ComboBoxItem Content="Pause"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="RE-EQUIP" Style="{StaticResource MetricLabel}"/>
                                    <ComboBox x:Name="CmbReEquipKey" Height="30" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0">
                                        <ComboBoxItem Content="F7" IsSelected="True"/>
                                        <ComboBoxItem Content="F8"/>
                                        <ComboBoxItem Content="F6"/>
                                        <ComboBoxItem Content="F4"/>
                                        <ComboBoxItem Content="Insert"/>
                                        <ComboBoxItem Content="Home"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EMERGENCY" Style="{StaticResource MetricLabel}"/>
                                    <TextBox Text="[End]" IsReadOnly="True" Height="30" Foreground="#9CA3AF" FontSize="11" TextAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ROW 6: SAVE CONFIG BUTTON (Full Width) -->
                            <Button x:Name="BtnSaveSettings" Grid.Row="6" Content="💾 Save Configuration" Click="BtnSaveSettings_Click" Height="34">
                            </Button>

                            <!-- Subtle App Version & Build Footer -->
                            <TextBlock Grid.Row="7" x:Name="TxtFooterVersion" Text="Fat Dad's Fisch AFK Pro v1.0.0" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                        </Grid>
                    </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 5. FULL MASCOT SPLASH SCREEN OVERLAY -->
        <Grid x:Name="OverlaySplash" Grid.RowSpan="5" Margin="-16" Background="#EE090C12"
              MouseLeftButtonDown="OverlaySplash_MouseLeftButtonDown" Cursor="Hand" Visibility="Visible">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="12"
                    Background="#0D111A" BorderBrush="#222C40" BorderThickness="1.5" CornerRadius="20" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.95" ShadowDepth="12"/>
                </Border.Effect>
                <StackPanel Orientation="Vertical">
                    <!-- Full Mascot Artwork -->
                    <Border CornerRadius="16" BorderBrush="#1F283A" BorderThickness="1.5" Background="#070A0F" ClipToBounds="True" Height="330" Margin="0,0,0,14">
                        <Grid>
                            <Image Source="splash_logo.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border VerticalAlignment="Bottom" Height="40">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000D111A" Offset="0.0"/>
                                        <GradientStop Color="#E60D111A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <TextBlock Text="FAT DAD'S" FontSize="25" FontWeight="Black" Foreground="#00E5FF" Margin="0,0,8,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#00E5FF" Opacity="0.45" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="FISCH AFK PRO" FontSize="25" FontWeight="Black" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtSplashVersion" Text="AUTONOMOUS KINETIC ANGLER • ROBLOX FISCH • v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Adaptive multi-rod kinetic model &amp; high-frequency vision" FontSize="11" Foreground="#91A8C4" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Status & Dismiss hint -->
                    <Border Background="#121722" CornerRadius="10" Padding="14,8" BorderBrush="#1A2230" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="#10B981" Opacity="0.8" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock x:Name="TxtSplashStatus" Text="Calibrating Multi-Rod Kinetic Model..." FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock Text="Click anywhere to continue ➔" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
