<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>Fat Dad's Fisch AFK Pro</AssemblyTitle>
    <Product>Fat Dad's Fisch AFK Pro</Product>
    <Description>High-frequency computer vision auto-angler for Roblox Fisch</Description>
    <ApplicationIcon>Assets/angler.ico</ApplicationIcon>
    <Version>1.0.15</Version>
    <AssemblyVersion>1.0.15.0</AssemblyVersion>
    <FileVersion>1.0.15.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);FischMacroCS.Tests\**;artifacts\**;dist\**;publish*\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app_icon.png" />
    <Resource Include="Assets/angler.png" />
    <Resource Include="Assets/angler.ico" />
    <Resource Include="app_icon.ico" />
    <Resource Include="splash_logo.png" />
    <EmbeddedResource Include="Assets\shake_template.png" />
    <EmbeddedResource Include="Assets\catch_prefix.png" />
    <EmbeddedResource Include="Assets\catch_prefix_live.png" />
    <EmbeddedResource Include="Assets\catch_prefix_maximized.png" />
    <EmbeddedResource Include="Assets\catch_prefix_1009.png" />
    <EmbeddedResource Include="Assets\disconnected_title.png" />
    <EmbeddedResource Include="Assets\reconnect_button.png" />
    <EmbeddedResource Include="Assets\fisch_loading_logo.png" />
    <EmbeddedResource Include="Assets\fisch_continue_prompt.png" />
    <EmbeddedResource Include="Assets\death_wasted.png" />
    <Content Include="Assets\shake_template.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Workflows\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>
